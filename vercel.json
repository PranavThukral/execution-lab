{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "APP_ENV": "production",
    "FRONTEND_EXTERNAL": "true",
    "TRUST_PROXY": "true",
    "ENABLE_IMPORTED_DATASETS": "false"
  },
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "redirects": [{ "source": "/", "destination": "/index.html", "permanent": false }],
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/healthz", "destination": { "service": "backend" } },
    { "source": "/readyz", "destination": { "service": "backend" } },
    { "source": "/docs", "destination": { "service": "backend" } },
    { "source": "/openapi.json", "destination": { "service": "backend" } },
    { "source": "/assets/:path*", "destination": { "service": "frontend" } },
    { "source": "/fonts/:path*", "destination": { "service": "frontend" } },
    { "source": "/favicon.svg", "destination": { "service": "frontend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
